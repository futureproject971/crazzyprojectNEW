+
+ImU32 ToU32(const ImVec4& c) { return ImGui::GetColorU32(c); }
+
+void AddPanelOutline(ImDrawList* draw, ImVec2 min, ImVec2 max, float rounding = PANEL_RADIUS) {
+    draw->AddRect(min, max, IM_COL32(36, 106, 255, 115), rounding, 0, 1.0f);
+    draw->AddRect(min + ImVec2(1,1), ImVec2(max.x - 1.0f, max.y - 1.0f), IM_COL32(8, 18, 48, 180), rounding, 0, 1.0f);
+}
+
+void BeginGlassPanel(const char* id, ImVec2 size = ImVec2(0,0)) {
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding, ImVec2(16, 16));
+    ImGui::BeginChild(id, size, true, ImGuiWindowFlags_NoScrollbar);
+    ImDrawList* draw = ImGui::GetWindowDrawList();
+    const ImVec2 min = ImGui::GetWindowPos();
+    const ImVec2 max = min + ImGui::GetWindowSize();
+    draw->AddRectFilledMultiColor(min, ImVec2(max.x, min.y + 84.0f), IM_COL32(9, 28, 82, 95), IM_COL32(4, 12, 38, 95), IM_COL32(9, 28, 82, 0), IM_COL32(4, 12, 38, 0));
+    AddPanelOutline(draw, min, max);
+}
+
+void EndGlassPanel() {
+    ImGui::EndChild();
+    ImGui::PopStyleVar();
+}
+
+ImVec4 ProductAccent(const Product& p) {
+    const auto g = U(p.game);
+    if (g == "VALORANT") return ImVec4(0.88f, 0.18f, 0.26f, 1.0f);
+    if (g == "RUST") return ImVec4(0.96f, 0.52f, 0.20f, 1.0f);
+    if (g == "CS2") return ImVec4(0.98f, 0.74f, 0.30f, 1.0f);
+    return ACCENT_BRIGHT;
+}
+
+const char* ProductGlyph(const Product& p) {
+    const auto g = U(p.game);
+    if (g == "VALORANT") return "V";
+    if (g == "RUST") return "R";
+    if (g == "CS2") return "C2";
+    return "CP";
+}
+
+const char* ProductStateLabel(const Product& p) {
+    if (p.maintenance) return "MANUTENÇÃO";
+    if (p.revoked) return "REVOGADO";
+    if (p.expired) return "EXPIRADO";
+    if (p.updateRequired) return "UPDATE";
+    return "ATIVO";
+}
+
+ImVec4 ProductStateColor(const Product& p) {
+    if (p.maintenance || p.expired) return WARNING;
+    if (p.revoked) return DANGER;
+    if (p.updateRequired) return ACCENT_BRIGHT;
+    return SUCCESS;
+}
+
+void SmallBadge(const char* text, const ImVec4& color, float width = 0.0f) {
+    ImGui::PushStyleColor(ImGuiCol_Button, color);
+    ImGui::PushStyleColor(ImGuiCol_ButtonHovered, color);
+    ImGui::PushStyleColor(ImGuiCol_ButtonActive, color);
+    ImGui::Button(text, ImVec2(width > 0.0f ? width : ImGui::CalcTextSize(text).x + 22.0f, 26.0f));
+    ImGui::PopStyleColor(3);
 }
 }
 
