+bool CircleButton(const char* id, ImU32 fill, const char* tooltip) {
+    const ImVec2 p = ImGui::GetCursorScreenPos();
+    const float d = 14.0f;
+    ImGui::InvisibleButton(id, ImVec2(d, d));
+    auto* draw = ImGui::GetWindowDrawList();
+    draw->AddCircleFilled(ImVec2(p.x + 7.0f, p.y + 7.0f), 7.0f, fill);
+    if (ImGui::IsItemHovered()) {
+        draw->AddCircle(ImVec2(p.x + 7.0f, p.y + 7.0f), 9.0f, IM_COL32(255,255,255,65), 24, 1.2f);
+        ImGui::SetTooltip("%s", tooltip);
+    }
+    return ImGui::IsItemClicked();
