# CRAZZY PROJECT
# Safe placeholders only. Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_ENABLE_DISCORD_AUTH=true
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# CRAZZY CALL / LiveKit
# Browser-safe public websocket URL:
NEXT_PUBLIC_LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud

# Server-only. NEVER prefix these with NEXT_PUBLIC_.
LIVEKIT_URL=https://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME

# M46 • MT Sounds partner
# Public partner URL, kept server-side so the integration can be swapped without rebuilding client code.
MTSOUNDS_MODE=embed
MTSOUNDS_URL=https://mtsounds.vercel.app/
